<?xml version="1.0" encoding="utf-8"?>
<!--
  Layout idea:
  Top    : TabLayout (Setup | Log | Result). Tap a tab to switch, tap the active tab to jump to its top.
  Middle : ONE scroller per tab. Text areas use the whole screen and scroll like a normal page.
  Bottom : sticky action bar (progress, status, Generate / Continue / Modify). It slides away while
           you scroll down to read, slides back when you scroll up / reach the end, and a small
           "Show actions" handle brings it back with one tap.
  Right  : small jump rail (top / end) for long text.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/section_tabs"
            style="@style/Widget.MaterialComponents.TabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabMode="fixed">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Setup" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Result" />
        </com.google.android.material.tabs.TabLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- ============ TAB 1: SETUP ============ -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/setup_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Enter a new app name or select an existing one to modify."
                        android:textAppearance="?attr/textAppearanceCaption" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/app_name_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="App Name (Default Example App: Tetris Game Black_White)">

                        <AutoCompleteTextView
                            android:id="@+id/app_name_autocomplete"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:completionThreshold="1"
                            android:imeOptions="actionNext"
                            android:inputType="textCapWords" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/app_version_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@+id/app_version_spinner"
                            android:text="Select Version to Work From:"
                            style="?android:attr/textAppearanceSmall" />

                        <Spinner
                            android:id="@+id/app_version_spinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/abc_spinner_textfield_background_material"
                            android:minHeight="48dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp" />
                    </LinearLayout>

                    <!-- No fixed height: starts at 6 lines, grows to 14, then scrolls itself. -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/app_description_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Description (Default: A simple black and white Tetris...)">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/app_description_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLines="14"
                            android:minLines="6"
                            android:scrollbars="vertical" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="AI PROVIDER &amp; MODEL"
                        android:textAppearance="?attr/textAppearanceOverline" />

                    <Spinner
                        android:id="@+id/provider_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/abc_spinner_textfield_background_material"
                        android:minHeight="48dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/api_key_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:hint="Gemini API Key"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/api_key_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/model_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/model_spinner"
                        android:text="Gemini Model"
                        style="?android:attr/textAppearanceSmall" />

                    <Spinner
                        android:id="@+id/model_spinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/abc_spinner_textfield_background_material"
                        android:minHeight="48dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp" />

                    <CheckBox
                        android:id="@+id/free_models_only_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Only show Free Models (Gemini Flash)" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/custom_model_input_layout"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:hint="Custom Model ID"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/custom_model_input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textNoSuggestions" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <CheckBox
                        android:id="@+id/auto_downgrade_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Ask to downgrade model if API is overloaded or quota reached" />

                    <TextView
                        android:id="@+id/request_counter_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="16dp"
                        android:text="API Requests Today: 0 / 1500 (Free Tier Limit)"
                        android:textAppearance="?attr/textAppearanceCaption"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="AUTOMATION"
                        android:textAppearance="?attr/textAppearanceOverline" />

                    <CheckBox
                        android:id="@+id/auto_fix_checkbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enable Fully Automated Build + Error Fixing (3 attempts)" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- ============ TAB 2: LOG (read-only, selectable, one scroller) ============ -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/log_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/log_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:hint="No log yet. Press the generate button to start."
                    android:padding="16dp"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </androidx.core.widget.NestedScrollView>

            <!-- ============ TAB 3: RESULT (AI conclusion) ============ -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/result_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ai_conclusion_output"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="No AI conclusion yet."
                    android:padding="16dp"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:textIsSelectable="true" />
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </LinearLayout>

    <!-- Jump rail: only the buttons that make sense are shown (set from code). -->
    <LinearLayout
        android:id="@+id/scroll_rail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/rail_top_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.85"
            android:contentDescription="Scroll to top"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="▲"
            android:visibility="gone" />

        <Button
            android:id="@+id/rail_end_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:alpha="0.85"
            android:contentDescription="Scroll to end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="▼"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Sticky action bar (overlays the bottom of the content; content gets matching bottom padding). -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ProgressBar
            android:id="@+id/loading_indicator"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Ready"
            android:textAppearance="?attr/textAppearanceBody2" />

        <LinearLayout
            android:id="@+id/action_buttons_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/continue_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/action_continue_to_build" />

            <Button
                android:id="@+id/modify_further_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Modify Further (Dismiss)" />
        </LinearLayout>

        <Button
            android:id="@+id/generate_app_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_generate_app_with_ai" />
    </LinearLayout>

    <!-- Shown only while the bar is slid away. One tap brings it back. -->
    <Button
        android:id="@+id/bottom_bar_handle"
        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:alpha="0.9"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:text="Show actions ▲"
        android:visibility="gone" />
</FrameLayout>